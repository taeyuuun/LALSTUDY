# Configure these only in Streamlit Cloud Secrets or local untracked secrets.toml.

GEMINI_API_KEY = "YOUR_PRIVATE_GEMINI_KEY"
MINERU_TOKEN = "YOUR_PRIVATE_MINERU_TOKEN"

# LALSTUDY Knowledge Archive
# Use the NEW backend-only Supabase secret key (sb_secret_...).
# Never expose this key in client/browser code.
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_YOUR_PRIVATE_KEY"

